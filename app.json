{
  "expo": {
    "name": "Budget Tracker",
    "slug": "budget-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "budget-tracker",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ivanwong.budgettracker"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
